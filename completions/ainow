# bash completion for ainow
# `ainow open<TAB>`            -> openrouter/
# `ainow openrouter/k<TAB>`    -> openrouter/moonshotai/kimi-k2 …
_ainow() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # only complete the model spec (first non-flag argument)
    local i argpos=0
    for ((i = 1; i < COMP_CWORD; i++)); do
        [[ "${COMP_WORDS[i]}" == -* ]] || ((argpos++))
    done
    if ((argpos > 0)); then
        COMPREPLY=()
        return 0
    fi

    if [[ "$cur" == -* ]]; then
        COMPREPLY=($(compgen -W "--refresh-models --providers --yolo --help" -- "$cur"))
        return 0
    fi

    local IFS=$'\n'
    COMPREPLY=($(ainow --complete "$cur" 2>/dev/null))

    # keep the cursor glued to "provider/" so you can carry on typing
    if ((${#COMPREPLY[@]} > 0)); then
        local all_slash=1 c
        for c in "${COMPREPLY[@]}"; do
            [[ "$c" == */ ]] || { all_slash=0; break; }
        done
        ((all_slash)) && compopt -o nospace 2>/dev/null
    fi
    return 0
}
complete -F _ainow ainow
